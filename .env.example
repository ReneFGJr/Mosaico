# Copie para .env no ambiente local e ajuste os valores; nunca versione credenciais.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.defaultLocale = 'pt-BR'
app.appTimezone = 'America/Sao_Paulo'

# A configuração atual usa MySQLi por padrão. As credenciais abaixo são apenas
# exemplos de desenvolvimento; os testes automatizados usam SQLite em memória.
database.default.hostname = localhost
database.default.database = mosaico
database.default.username = mosaico
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306